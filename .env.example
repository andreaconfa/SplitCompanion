# Docker: choose a published version/digest, or the local build tag below.
SPLIT_COMPANION_IMAGE=splitcompanion:1.2.0-rc.3
SPLIT_COMPANION_BIND=127.0.0.1
SPLIT_COMPANION_PORT=8000
SPLIT_COMPANION_DATA_DIR=./data
SPLIT_COMPANION_BACKUP_DIR=./backups
SPLIT_COMPANION_TIMEZONE=UTC
# Explicit HTTP for local use. For external HTTPS, configure PUBLIC_ORIGIN and proxy IPs.
SPLIT_COMPANION_ALLOW_HTTP=true
SPLIT_COMPANION_PUBLIC_ORIGIN=
SPLIT_COMPANION_TRUSTED_PROXY_IPS=
SPLIT_COMPANION_MFA_REQUIRED=true
SPLIT_COMPANION_PUSH_ENABLED=false
# Enable push only with your own public HTTPS origin/contact.
SPLIT_COMPANION_PUSH_VAPID_SUBJECT=
